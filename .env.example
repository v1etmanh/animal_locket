# =====================================================================================
#  ANIMAL LOCKET — biến môi trường cho docker compose
#  Sao chép thành .env:   cp .env.example .env
#
#  !!! TOÀN BỘ GIÁ TRỊ DƯỚI ĐÂY CHỈ LÀ GIÁ TRỊ MẪU CHO MÁY DEV. !!!
#  !!! ĐỔI HẾT MẬT KHẨU/KHOÁ TRƯỚC KHI ĐƯA LÊN BẤT KỲ MÁY CHỦ NÀO. KHÔNG COMMIT FILE .env. !!!
#  Gợi ý sinh giá trị ngẫu nhiên:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
#  Mật khẩu chỉ nên dùng chữ và số (có vào chuỗi kết nối Mongo/JDBC nên ký tự đặc biệt sẽ gây lỗi).
# =====================================================================================

COMPOSE_PROJECT_NAME=animal-locket
# Profile bật mặc định cho lệnh "docker compose up". core=hạ tầng, app=service, obs=giám sát.
# Mọi profile khác luôn cần "core" đi kèm (service app phụ thuộc Kafka/Redis ở core).
COMPOSE_PROFILES=core,app

# ---- Địa chỉ công khai (Traefik) ------------------------------------------------------
# Các host sẽ là: api.<PUBLIC_DOMAIN>, auth.<PUBLIC_DOMAIN>, grafana.<PUBLIC_DOMAIN>
# Dev trên máy: "localhost" (trình duyệt tự phân giải *.localhost). Điện thoại thật cùng Wi‑Fi: dùng tên miền trỏ về IP máy,
# ví dụ 192-168-1-20.nip.io  (=> api.192-168-1-20.nip.io ...).
PUBLIC_DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=443

# URL công khai của Keycloak; là "iss" trong JWT và là địa chỉ app di động mở khi đăng nhập. Cũng phải khớp host/cổng client dùng.
KEYCLOAK_PUBLIC_URL=http://auth.localhost:8080

# ---- Cơ sở dữ liệu --------------------------------------------------------------------
# MySQL do Aiven (user-service, media-service, post-service dùng chung một server, ba database user_db/media_db/post_db).
# Aiven bắt buộc SSL. Mật khẩu chỉ chữ và số.
MYSQL_HOST=CHANGE_ME_xxx.a.aivencloud.com
MYSQL_PORT=CHANGE_ME_port
MYSQL_USER=animal_app
MYSQL_PASSWORD=CHANGE_ME_mysql
# Postgres do Supabase (Session pooler). Chạy deploy/supabase/init.sql trước để tạo role + schema.
# User có dạng <role>.<project-ref>. Mật khẩu chỉ chữ và số.
BILLING_DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
BILLING_DB_USER=billing_app.CHANGE_ME_project_ref
BILLING_DB_PASSWORD=CHANGE_ME_billing_db
KEYCLOAK_DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
KEYCLOAK_DB_USER=keycloak_app.CHANGE_ME_project_ref
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db
# MongoDB Atlas (chat-service). Mật khẩu chỉ chữ và số. Phải có tên database chat_db trước dấu ?
MONGO_URI=mongodb+srv://CHANGE_ME_user:CHANGE_ME_password@CHANGE_ME_cluster.mongodb.net/chat_db?retryWrites=true&w=majority
REDIS_PASSWORD=CHANGE_ME_redis
# Cách Hibernate xử lý schema khi khởi động (schema do Flyway tạo). Mặc định none cho an toàn vì chưa kiểm chứng được
# "validate" trên MySQL thật. Sau khi chạy thử compose ổn, thử đặt validate để bắt sớm lệch giữa entity và migration
# (nếu gặp lỗi "wrong column type" với cột enum trên MySQL thì quay về none; xem deploy/README.md, mục Xử lý sự cố).
JPA_DDL_AUTO=none

# ---- Cloudflare R2 (kho ảnh, một bucket riêng tư) -----------------------------------------
# Endpoint dạng https://<account-id>.r2.cloudflarestorage.com. Token chỉ cần quyền Object Read & Write trên bucket này.
R2_ENDPOINT=https://CHANGE_ME_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME_r2_access_key_id
R2_SECRET_KEY=CHANGE_ME_r2_secret_access_key
R2_BUCKET=animal-photos

# ---- Keycloak -------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
# Secret của service account "user-service-admin" (dùng để xoá user trong Keycloak khi người dùng xoá tài khoản).
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_keycloak_sa_secret

# ---- Test chat (CHỈ DEV, để trống trên máy chủ thật) ---------------------------------------
# publicId (20 ký tự) của một tài khoản đã đăng ký bình thường qua app. Tài khoản này tự thành bạn của
# mọi tài khoản đăng ký mới, và của mọi tài khoản cũ mỗi lần user-service khởi động. Đăng nhập bằng nó
# trên máy/emulator thứ hai để nhắn qua lại. Trống = tắt.
DEV_BUDDY_PUBLIC_ID=

# ---- Bí mật dùng chung giữa các service ------------------------------------------------
# Khoá gọi nội bộ service-to-service (header X-Internal-Token). Tối thiểu 32 ký tự ngẫu nhiên.
INTERNAL_TOKEN=CHANGE_ME_internal_token_at_least_32_chars
# Khoá tạo độ lệch vị trí cố định theo từng người (discovery-service). Đổi giá trị sẽ làm dịch toàn bộ vị trí đã lưu.
DISCOVERY_SECRET=CHANGE_ME_discovery_secret_at_least_32_chars
# Tài khoản Basic auth của Config Server.
CONFIG_USER=config
CONFIG_PASSWORD=CHANGE_ME_config_server

# ---- Push thông báo (tuỳ chọn) --------------------------------------------------------
# Đặt file khoá dịch vụ Firebase vào deploy/secrets/ rồi khai báo đường dẫn TRONG container, ví dụ /secrets/fcm.json.
# Để trống = chỉ ghi log, không gửi push thật.
FCM_CREDENTIALS_FILE=

# ---- Thanh toán -----------------------------------------------------------------------
# CHỈ bật true khi phát triển (tin biên lai do client tự khai). KHÔNG BAO GIỜ bật ở production.
BILLING_DEV_STORE=false

# ---- Glyph chat (chat-service) --------------------------------------------------------
# false = rollback: tắt tạo/gỡ/gửi ký hiệu, vẫn đọc được lịch sử và từ điển.
GLYPH_WRITE_ENABLED=true
GLYPH_MAX_ACTIVE=100
GLYPH_MAX_CREATES_PER_DAY=20
# Bảng màu (#RRGGBB, phân cách bằng dấu phẩy) mặc định đặt trong docker-compose.yml, phải khớp mobile.
# Muốn đổi thì đặt GLYPH_PALETTE trong dấu nháy: GLYPH_PALETTE="#818CF8,#34D399"

# ---- Quan sát (profile obs) -----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
# Tỉ lệ lấy mẫu trace (0.0–1.0). Dev để 1.0, production nên 0.05–0.1.
TRACE_SAMPLING=1.0

# ---- Phiên bản image (ghim để build lặp lại được; đổi khi cần) ---------------------------
TRAEFIK_IMAGE=traefik:v3
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
